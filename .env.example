# Runtime
USE_SAMPLE_DB=true
PROMPT_MODE=full
HEURISTICS_ENABLED=true
RAG_ENABLED=true
LLM_TEMPERATURE=0.0
LLM_BATCH_SIZE=4
MAX_CONCURRENT_LLM_REQUESTS=4
LLM_PARSE_MAX_ATTEMPTS=3
STAGE_1_MAX_TOKENS=4096

# Local OpenAI-compatible LLM endpoint
DEFAULT_LLM_OPENAI_API_KEY=local-placeholder
DEFAULT_LLM_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
DEFAULT_LLM=gpt-oss:120b
STAGE_1_LLM_OPENAI_API_KEY=local-placeholder
STAGE_1_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
STAGE1_LLM=gpt-oss:120b
STAGE_2_LLM_OPENAI_API_KEY=local-placeholder
STAGE_2_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
STAGE_2_LLM=gpt-oss:120b

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_OPENAI_API_KEY=local-placeholder
LEGAL_EMBEDDING_MODEL=woong0322/ko-legal-sbert-finetuned
FEEDBACK_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval score:
# score = alpha * semantic_similarity + (1 - alpha) * authority
SEMANTIC_SIMILARITY_WEIGHT=0.7
EXPERT_FEEDBACK_WEIGHT=1.0
INTERNAL_POLICY_WEIGHT=0.8
NATIONAL_LAW_WEIGHT=0.6
INTERNATIONAL_REGULATIONS_WEIGHT=0.4
CHUNK_SIZE=128
CHUNK_OVERLAP=30
TOP_K_RESULTS=3
MAX_CONTEXT_TOKENS=30000
FEEDBACK_MAX_LENGTH=200

# Auditing and transport
LLM_AUDIT_ENABLED=true
ENABLE_STREAMING=true
STREAMING_LOG_CHUNKS=false
TLS_VERIFY=true
# TLS_CA_BUNDLE=/absolute/path/to/private-ca.pem

# Optional external database connection
DB_TYPE=duckdb
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
